    run_test("test_format_type_mismatch_no_context", test_format_type_mismatch_no_context)
    run_test("test_format_type_mismatch_with_context", test_format_type_mismatch_with_context)
    run_test("test_format_invalid_value_no_context", test_format_invalid_value_no_context)
