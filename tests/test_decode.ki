    run_test("test_required_int_negative", test_required_int_negative)
    run_test("test_required_int_large", test_required_int_large)
    run_test("test_required_int_truncates_float", test_required_int_truncates_float)
    run_test("test_required_int_missing", test_required_int_missing)
    run_test("test_required_int_wrong_type", test_required_int_wrong_type)
    std.io.println("")
    return
}

