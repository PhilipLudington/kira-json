// =============================================================================
// Test Runner
// =============================================================================

effect fn run_test(name: string, test_fn: fn() -> void) -> void {
    std.io.print("  ")
    std.io.print(name)
    std.io.print(" ... ")
    test_fn()
    std.io.println("ok")
    return
}

effect fn run_required_string_tests() -> void {
    std.io.println("required_string:")
    run_test("test_required_string_happy_path", test_required_string_happy_path)
    run_test("test_required_string_empty_value", test_required_string_empty_value)
    run_test("test_required_string_missing_field", test_required_string_missing_field)
    run_test("test_required_string_wrong_type_number", test_required_string_wrong_type_number)
    run_test("test_required_string_wrong_type_bool", test_required_string_wrong_type_bool)
    run_test("test_required_string_wrong_type_null", test_required_string_wrong_type_null)
    run_test("test_required_string_wrong_type_array", test_required_string_wrong_type_array)
    run_test("test_required_string_wrong_type_object", test_required_string_wrong_type_object)
    std.io.println("")
    return
}

effect fn run_required_number_tests() -> void {
    std.io.println("required_number:")
    run_test("test_required_number_happy_path", test_required_number_happy_path)
    run_test("test_required_number_integer_value", test_required_number_integer_value)
    run_test("test_required_number_zero", test_required_number_zero)
    run_test("test_required_number_negative", test_required_number_negative)
    run_test("test_required_number_missing", test_required_number_missing)
    run_test("test_required_number_wrong_type", test_required_number_wrong_type)
    std.io.println("")
    return
}

effect fn run_required_int_tests() -> void {
