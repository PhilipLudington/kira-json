// =============================================================================
// Test: Composed nested object decoding (integration)
// =============================================================================

/// Composed decoder: extract object field, decode, wrap context.
let test_composed_nested_object_happy: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"address\": {\"street\": \"123 Main\", \"city\": \"NYC\"}}")
    match required_object_field(json, "address") {
        Err(e) => { assert(false, std.string.concat("composed nested happy: ", format_decode_error(e))) }
        Ok(addr_json) => {
            match decode_address(addr_json) {
                Err(e) => { assert(false, std.string.concat("composed nested happy decode: ", format_decode_error(e))) }
                Ok(addr) => {
                    assert_str_eq(addr.street, "123 Main", "composed nested: street")
                    assert_str_eq(addr.city, "NYC", "composed nested: city")
                }
            }
        }
    }
    return
}

let test_composed_nested_object_error_with_context: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"address\": {\"street\": \"123 Main\"}}")
    match required_object_field(json, "address") {
        Err(e) => { assert(false, std.string.concat("composed nested error: ", format_decode_error(e))) }
        Ok(addr_json) => {
            match decode_address(addr_json) {
                Ok(_) => { assert(false, "composed nested error: expected Err from decode") }
                Err(e) => {
                    let wrapped: DecodeError = with_context(e, "address")
                    let msg: string = format_decode_error(wrapped)
                    assert_str_eq(msg, "Missing required field 'city' in address", "composed nested error message")
                }
            }
        }
    }
    return
}

