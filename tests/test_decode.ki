    let json: Json = parse_ok("{\"name\": \"Bob\"}")
    let result: Option[string] = optional_string(json, "name")
    match result {
        Some(s) => { assert_str_eq(s, "Bob", "optional_string should return 'Bob'") }
        None => { assert(false, "optional_string present: expected Some") }
    }
    return
}

let test_optional_string_missing: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"age\": 30}")
    let result: Option[string] = optional_string(json, "name")
    match result {
        Some(_) => { assert(false, "optional_string missing: expected None") }
        None => { return }
    }
    return
}

