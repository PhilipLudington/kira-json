let test_required_bool_wrong_type_number: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"active\": 1}")
    let result: Result[bool, DecodeError] = required_bool(json, "active")
    match result {
        Ok(_) => { assert(false, "required_bool wrong type number: expected Err") }
        Err(TypeMismatch { field: _, expected: _, actual: act, context: _ }) => {
            assert(std.string.equals(act, "number"), "required_bool wrong type: actual should be 'number'")
        }
        Err(_) => { assert(false, "required_bool wrong type number: expected TypeMismatch") }
