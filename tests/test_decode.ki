        Ok(items) => {
            match decode_string_list(items, 0) {
                Err(e) => { assert(false, std.string.concat("composed array decode: ", format_decode_error(e))) }
                Ok(values) => {
                    assert(std.list.length(values) == 3, "composed array: length should be 3")
                }
            }
        }
    }
    return
}

let test_composed_array_element_error: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"tags\": [\"ok\", 42]}")
    match required_array_field(json, "tags") {
        Err(_) => { assert(false, "composed array error: field extraction should succeed") }
        Ok(items) => {
            match decode_string_list(items, 0) {
                Ok(_) => { assert(false, "composed array error: expected Err from decode") }
                Err(e) => {
                    let wrapped: DecodeError = with_context(e, "tags")
                    let msg: string = format_decode_error(wrapped)
                    assert_str_eq(msg, "Type mismatch for field '(element)' in tags[1]: expected string, got number", "composed array error message")
                }
            }
        }
    }
    return
}

let test_composed_array_of_users: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"users\": [{\"name\": \"Alice\", \"age\": 30}, {\"name\": \"Bob\", \"age\": 25}]}")
    match required_array_field(json, "users") {
        Err(e) => { assert(false, std.string.concat("composed user array: ", format_decode_error(e))) }
        Ok(items) => {
            match decode_user_list(items, 0) {
                Err(e) => { assert(false, std.string.concat("composed user array decode: ", format_decode_error(e))) }
                Ok(users) => {
                    assert(std.list.length(users) == 2, "composed user array: length should be 2")
                }
            }
        }
    }
    return
}

let test_composed_array_of_users_error: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"users\": [{\"name\": \"Alice\", \"age\": 30}, {\"name\": \"Bob\"}]}")
    match required_array_field(json, "users") {
        Err(_) => { assert(false, "composed user array error: field extraction should succeed") }
        Ok(items) => {
            match decode_user_list(items, 0) {
                Ok(_) => { assert(false, "composed user array error: expected Err") }
                Err(e) => {
                    let wrapped: DecodeError = with_context(e, "users")
                    match wrapped {
                        MissingField { field: f, context: ctx } => {
                            assert(std.string.equals(f, "age"), "user array error: field should be 'age'")
                            assert(std.string.equals(ctx, "users[1]"), "user array error: context should be 'users[1]'")
                        }
                        _ => { assert(false, "user array error: expected MissingField") }
                    }
                }
            }
        }
    }
    return
}

// =============================================================================
// Test: Deep nested path (object -> object -> missing field)
// =============================================================================

/// Decoder for User with Address using composed object field extraction.
let decode_user_with_address: fn(Json) -> Result[UserWithAddress, DecodeError] =
    fn(json: Json) -> Result[UserWithAddress, DecodeError] {
        match required_string(json, "name") {
            Err(e) => { return Err(e) }
            Ok(name) => {
                match required_object_field(json, "address") {
                    Err(e) => { return Err(e) }
                    Ok(addr_json) => {
                        match decode_address(addr_json) {
                            Err(e) => { return Err(with_context(e, "address")) }
                            Ok(addr) => {
                                return Ok(UserWithAddress { name: name, address: addr })
                            }
                        }
                    }
                }
            }
        }
    }

type UserWithAddress = {
    name: string,
    address: Address
}

let test_deep_nested_happy: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"Alice\", \"address\": {\"street\": \"Main\", \"city\": \"NYC\"}}")
    match decode_user_with_address(json) {
        Ok(u) => {
            assert_str_eq(u.name, "Alice", "deep nested happy: name")
            assert_str_eq(u.address.street, "Main", "deep nested happy: street")
            assert_str_eq(u.address.city, "NYC", "deep nested happy: city")
        }
        Err(e) => { assert(false, std.string.concat("deep nested happy failed: ", format_decode_error(e))) }
    }
    return
}

let test_deep_nested_error_path: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"Alice\", \"address\": {\"street\": \"Main\"}}")
    match decode_user_with_address(json) {
        Ok(_) => { assert(false, "deep nested error: expected Err") }
        Err(MissingField { field: f, context: ctx }) => {
            assert(std.string.equals(f, "city"), "deep nested error: field should be 'city'")
            assert(std.string.equals(ctx, "address"), "deep nested error: context should be 'address'")
        }
        Err(_) => { assert(false, "deep nested error: expected MissingField") }
    }
    return
}

/// Decodes a list of UserWithAddress with index context.
let decode_uwa_list: fn(List[Json], i32) -> Result[List[UserWithAddress], DecodeError] =
    fn(items: List[Json], index: i32) -> Result[List[UserWithAddress], DecodeError] {
        match items {
            Nil => { return Ok(Nil) }
            Cons(item, rest) => {
                match decode_user_with_address(item) {
                    Err(e) => {
                        return Err(with_context(e, index_context(index)))
                    }
                    Ok(uwa) => {
                        match decode_uwa_list(rest, index + 1) {
                            Err(e) => { return Err(e) }
                            Ok(rest_values) => { return Ok(Cons(uwa, rest_values)) }
                        }
                    }
                }
            }
        }
    }

let test_array_deep_nested_error_path: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"team\": [{\"name\": \"Alice\", \"address\": {\"street\": \"Main\", \"city\": \"NYC\"}}, {\"name\": \"Bob\", \"address\": {\"street\": \"Elm\"}}]}")
    match required_array_field(json, "team") {
        Err(_) => { assert(false, "array deep: field extraction should succeed") }
        Ok(items) => {
            match decode_uwa_list(items, 0) {
                Ok(_) => { assert(false, "array deep: expected Err") }
                Err(e) => {
                    let wrapped: DecodeError = with_context(e, "team")
                    match wrapped {
                        MissingField { field: f, context: ctx } => {
                            assert(std.string.equals(f, "city"), "array deep: field should be 'city'")
                            assert(std.string.equals(ctx, "team[1].address"), "array deep: context should be 'team[1].address'")
                        }
                        _ => { assert(false, "array deep: expected MissingField") }
                    }
                }
            }
        }
    }
    return
}

// =============================================================================
// Phase 2: Nullable Decoders
// =============================================================================

let test_nullable_string_present: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"Alice\"}")
    let result: Result[Option[string], DecodeError] = nullable_string(json, "name")
    match result {
        Ok(Some(s)) => { assert_str_eq(s, "Alice", "nullable_string present") }
        Ok(None) => { assert(false, "nullable_string present: expected Some") }
        Err(e) => { assert(false, std.string.concat("nullable_string present: ", format_decode_error(e))) }
    }
    return
}

let test_nullable_string_null: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": null}")
    let result: Result[Option[string], DecodeError] = nullable_string(json, "name")
    match result {
        Ok(None) => { return }
        Ok(Some(_)) => { assert(false, "nullable_string null: expected None") }
        Err(e) => { assert(false, std.string.concat("nullable_string null: ", format_decode_error(e))) }
    }
    return
}

let test_nullable_string_missing: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"age\": 30}")
    let result: Result[Option[string], DecodeError] = nullable_string(json, "name")
    match result {
        Err(MissingField { field: f, context: _ }) => {
            assert(std.string.equals(f, "name"), "nullable_string missing: wrong field")
        }
        Err(_) => { assert(false, "nullable_string missing: expected MissingField") }
        Ok(_) => { assert(false, "nullable_string missing: expected Err") }
    }
    return
}

let test_nullable_string_wrong_type: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": 42}")
    let result: Result[Option[string], DecodeError] = nullable_string(json, "name")
    match result {
        Err(TypeMismatch { field: _, expected: exp, actual: _, context: _ }) => {
            assert(std.string.equals(exp, "string or null"), "nullable_string wrong type: expected 'string or null'")
        }
        Err(_) => { assert(false, "nullable_string wrong type: expected TypeMismatch") }
        Ok(_) => { assert(false, "nullable_string wrong type: expected Err") }
    }
    return
}

