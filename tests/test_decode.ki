let test_required_bool_wrong_type_string: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"active\": \"yes\"}")
    let result: Result[bool, DecodeError] = required_bool(json, "active")
    match result {
        Ok(_) => { assert(false, "required_bool wrong type: expected Err") }
        Err(TypeMismatch { field: f, expected: exp, actual: act, context: _ }) => {
            assert(std.string.equals(f, "active"), "required_bool wrong type: wrong field")
            assert(std.string.equals(exp, "boolean"), "required_bool wrong type: wrong expected")
