// =============================================================================
// Phase 1: Test Types and Decoders
// =============================================================================

/// Simple Address type for testing nested object decoding.
type Address = {
    street: string,
    city: string
}

/// Simple User type for testing nested object + array decoding.
type User = {
    name: string,
    age: i64
}

/// Decoder for Address from JSON.
let decode_address: fn(Json) -> Result[Address, DecodeError] =
    fn(json: Json) -> Result[Address, DecodeError] {
        match required_string(json, "street") {
            Err(e) => { return Err(e) }
            Ok(street) => {
                match required_string(json, "city") {
                    Err(e) => { return Err(e) }
                    Ok(city) => {
                        return Ok(Address { street: street, city: city })
                    }
                }
            }
        }
    }

/// Decoder for User from JSON.
let decode_user: fn(Json) -> Result[User, DecodeError] =
    fn(json: Json) -> Result[User, DecodeError] {
        match required_string(json, "name") {
            Err(e) => { return Err(e) }
            Ok(name) => {
                match required_int(json, "age") {
                    Err(e) => { return Err(e) }
                    Ok(age) => {
                        return Ok(User { name: name, age: age })
                    }
                }
            }
        }
    }

/// Decodes a list of JSON strings with index context tracking.
let decode_string_list: fn(List[Json], i32) -> Result[List[string], DecodeError] =
    fn(items: List[Json], index: i32) -> Result[List[string], DecodeError] {
        match items {
            Nil => { return Ok(Nil) }
            Cons(item, rest) => {
                match item {
                    JString(s) => {
                        match decode_string_list(rest, index + 1) {
                            Err(e) => { return Err(e) }
                            Ok(rest_values) => { return Ok(Cons(s, rest_values)) }
                        }
                    }
                    _ => {
                        let err: DecodeError = TypeMismatch {
                            field: "(element)",
                            expected: "string",
                            actual: type_name(item),
                            context: ""
                        }
                        return Err(with_context(err, index_context(index)))
                    }
                }
            }
        }
    }

/// Decodes a list of JSON objects into User values with index context tracking.
let decode_user_list: fn(List[Json], i32) -> Result[List[User], DecodeError] =
    fn(items: List[Json], index: i32) -> Result[List[User], DecodeError] {
        match items {
            Nil => { return Ok(Nil) }
            Cons(item, rest) => {
                match decode_user(item) {
                    Err(e) => {
                        return Err(with_context(e, index_context(index)))
                    }
                    Ok(user) => {
                        match decode_user_list(rest, index + 1) {
                            Err(e) => { return Err(e) }
                            Ok(rest_values) => { return Ok(Cons(user, rest_values)) }
                        }
                    }
                }
            }
        }
    }

// =============================================================================
// Test: with_context
// =============================================================================

let test_with_context_missing_field_empty: fn() -> void = fn() -> void {
    let err: DecodeError = MissingField { field: "email", context: "" }
    let wrapped: DecodeError = with_context(err, "user")
    let msg: string = format_decode_error(wrapped)
    assert_str_eq(msg, "Missing required field 'email' in user", "with_context on empty context")
    return
}

let test_with_context_missing_field_existing: fn() -> void = fn() -> void {
    let err: DecodeError = MissingField { field: "city", context: "address" }
    let wrapped: DecodeError = with_context(err, "user")
    let msg: string = format_decode_error(wrapped)
    assert_str_eq(msg, "Missing required field 'city' in user.address", "with_context prepends with dot")
    return
}

let test_with_context_array_index: fn() -> void = fn() -> void {
    let err: DecodeError = MissingField { field: "email", context: "" }
    let wrapped: DecodeError = with_context(err, "[0]")
    let msg: string = format_decode_error(wrapped)
    assert_str_eq(msg, "Missing required field 'email' in [0]", "with_context with array index")
    return
}

let test_with_context_field_then_index: fn() -> void = fn() -> void {
    let err: DecodeError = MissingField { field: "email", context: "" }
    let step1: DecodeError = with_context(err, "[2]")
    let step2: DecodeError = with_context(step1, "users")
    let msg: string = format_decode_error(step2)
    assert_str_eq(msg, "Missing required field 'email' in users[2]", "with_context nested: users[2]")
    return
}

let test_with_context_deep_nesting: fn() -> void = fn() -> void {
    let err: DecodeError = MissingField { field: "zip", context: "" }
    let step1: DecodeError = with_context(err, "address")
    let step2: DecodeError = with_context(step1, "[0]")
    let step3: DecodeError = with_context(step2, "users")
    let msg: string = format_decode_error(step3)
    assert_str_eq(msg, "Missing required field 'zip' in users[0].address", "with_context deep: users[0].address")
    return
}

let test_with_context_type_mismatch: fn() -> void = fn() -> void {
    let err: DecodeError = TypeMismatch { field: "age", expected: "number", actual: "string", context: "" }
    let wrapped: DecodeError = with_context(err, "user")
    let msg: string = format_decode_error(wrapped)
    assert_str_eq(msg, "Type mismatch for field 'age' in user: expected number, got string", "with_context on TypeMismatch")
    return
}

let test_with_context_invalid_value: fn() -> void = fn() -> void {
    let err: DecodeError = InvalidValue { field: "status", message: "unknown", context: "" }
    let wrapped: DecodeError = with_context(err, "order")
    let msg: string = format_decode_error(wrapped)
    assert_str_eq(msg, "Invalid value for field 'status' in order: unknown", "with_context on InvalidValue")
    return
}

