let test_required_string_in_valid: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"status\": \"active\"}")
    let allowed: List[string] = Cons("active", Cons("inactive", Cons("pending", Nil)))
    let result: Result[string, DecodeError] = required_string_in(json, "status", allowed)
    match result {
        Ok(s) => { assert_str_eq(s, "active", "required_string_in valid") }
        Err(e) => { assert(false, std.string.concat("required_string_in valid: ", format_decode_error(e))) }
    }
    return
}

let test_required_string_in_invalid: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"status\": \"deleted\"}")
    let allowed: List[string] = Cons("active", Cons("inactive", Cons("pending", Nil)))
    let result: Result[string, DecodeError] = required_string_in(json, "status", allowed)
    match result {
        Err(InvalidValue { field: f, message: _, context: _ }) => {
            assert(std.string.equals(f, "status"), "required_string_in invalid: field")
        }
        Err(_) => { assert(false, "required_string_in invalid: expected InvalidValue") }
        Ok(_) => { assert(false, "required_string_in invalid: expected Err") }
    }
    return
}

let test_required_string_in_missing: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{}")
    let allowed: List[string] = Cons("active", Cons("inactive", Nil))
    let result: Result[string, DecodeError] = required_string_in(json, "status", allowed)
    match result {
        Err(MissingField { field: _, context: _ }) => { return }
        Err(_) => { assert(false, "required_string_in missing: expected MissingField") }
        Ok(_) => { assert(false, "required_string_in missing: expected Err") }
    }
    return
}

let test_required_string_in_wrong_type: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"status\": 42}")
    let allowed: List[string] = Cons("active", Cons("inactive", Nil))
    let result: Result[string, DecodeError] = required_string_in(json, "status", allowed)
    match result {
        Err(TypeMismatch { field: _, expected: _, actual: _, context: _ }) => { return }
        Err(_) => { assert(false, "required_string_in wrong type: expected TypeMismatch") }
        Ok(_) => { assert(false, "required_string_in wrong type: expected Err") }
    }
    return
}

let test_required_string_in_error_message: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"status\": \"deleted\"}")
    let allowed: List[string] = Cons("active", Cons("inactive", Nil))
    let result: Result[string, DecodeError] = required_string_in(json, "status", allowed)
    match result {
        Err(InvalidValue { field: _, message: msg, context: _ }) => {
            assert_str_eq(msg, "expected one of [active, inactive], got 'deleted'", "required_string_in error message")
        }
        Err(_) => { assert(false, "required_string_in error msg: expected InvalidValue") }
        Ok(_) => { assert(false, "required_string_in error msg: expected Err") }
    }
    return
}

