effect fn run_edge_case_tests() -> void {
    std.io.println("Edge Cases:")
    run_test("test_required_string_from_empty_object", test_required_string_from_empty_object)
    run_test("test_optional_string_from_empty_object", test_optional_string_from_empty_object)
    run_test("test_multiple_required_fields", test_multiple_required_fields)
    run_test("test_mix_required_and_optional", test_mix_required_and_optional)
    run_test("test_required_string_from_non_object", test_required_string_from_non_object)
    run_test("test_required_int_from_array", test_required_int_from_array)
    run_test("test_optional_bool_from_null", test_optional_bool_from_null)
    std.io.println("")
    return
}

effect fn main() -> void {
    std.io.println("Running Decode Module Tests")
    std.io.println("===========================")
    std.io.println("")
    run_required_string_tests()
    run_required_number_tests()
    run_required_int_tests()
    run_required_bool_tests()
    run_required_field_tests()
    run_optional_string_tests()
    run_optional_number_tests()
    run_optional_int_tests()
    run_optional_bool_tests()
    run_optional_field_tests()
    run_format_error_tests()
    run_edge_case_tests()
    std.io.println("===========================")
    std.io.println("All 53 decode tests passed!")
    return
}
