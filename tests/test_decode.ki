//! Tests for the json.decode module.
//! Covers required/optional field extractors, error types, and error formatting.

module test_decode

import json.types.{ Json, JsonField, get_field, type_name, fields_to_hashmap }
import json.parser.{ parse }
import json.decode.{ DecodeError, format_decode_error, required_string, required_number, required_int, required_bool, required_field, optional_string, optional_number, optional_int, optional_bool, optional_field }

// =============================================================================
// Test Utilities
// =============================================================================

let assert_true: fn(bool, string) -> void = fn(condition: bool, message: string) -> void {
    assert(condition, message)
    return
}

let assert_str_eq: fn(string, string, string) -> void =
    fn(actual: string, expected: string, message: string) -> void {
        assert(std.string.equals(actual, expected), message)
        return
    }

/// Helper to create a test JSON object from a parsed string.
let parse_ok: fn(string) -> Json = fn(input: string) -> Json {
    match parse(input) {
        Ok(json) => { return json }
        Err(_) => {
            assert(false, "parse_ok: failed to parse JSON")
            return JNull
        }
    }
}

/// Asserts that a Result is Ok and returns the value.
let assert_ok_string: fn(Result[string, DecodeError], string) -> string =
    fn(result: Result[string, DecodeError], message: string) -> string {
        match result {
            Ok(v) => { return v }
            Err(e) => {
                assert(false, std.string.concat(message, std.string.concat(": got Err: ", format_decode_error(e))))
                return ""
            }
        }
    }

let assert_ok_f64: fn(Result[f64, DecodeError], string) -> f64 =
    fn(result: Result[f64, DecodeError], message: string) -> f64 {
        match result {
            Ok(v) => { return v }
            Err(e) => {
                assert(false, std.string.concat(message, std.string.concat(": got Err: ", format_decode_error(e))))
                return 0.0
            }
        }
    }

let assert_ok_i64: fn(Result[i64, DecodeError], string) -> i64 =
    fn(result: Result[i64, DecodeError], message: string) -> i64 {
        match result {
            Ok(v) => { return v }
            Err(e) => {
                assert(false, std.string.concat(message, std.string.concat(": got Err: ", format_decode_error(e))))
                return 0i64
            }
        }
    }

let assert_ok_bool: fn(Result[bool, DecodeError], string) -> bool =
    fn(result: Result[bool, DecodeError], message: string) -> bool {
        match result {
            Ok(v) => { return v }
            Err(e) => {
                assert(false, std.string.concat(message, std.string.concat(": got Err: ", format_decode_error(e))))
                return false
            }
        }
    }

let assert_ok_json: fn(Result[Json, DecodeError], string) -> Json =
    fn(result: Result[Json, DecodeError], message: string) -> Json {
        match result {
            Ok(v) => { return v }
            Err(e) => {
                assert(false, std.string.concat(message, std.string.concat(": got Err: ", format_decode_error(e))))
                return JNull
            }
        }
    }

/// Asserts that a Result is Err with a MissingField variant.
let assert_missing_field: fn(Result[string, DecodeError], string, string) -> void =
    fn(result: Result[string, DecodeError], expected_field: string, message: string) -> void {
        match result {
            Ok(_) => { assert(false, std.string.concat(message, ": expected Err, got Ok")) }
            Err(MissingField { field: f, context: _ }) => {
                assert(std.string.equals(f, expected_field), std.string.concat(message, ": wrong field name"))
            }
            Err(_) => { assert(false, std.string.concat(message, ": expected MissingField, got different error")) }
        }
        return
    }

/// Asserts that a Result is Err with a TypeMismatch variant.
let assert_type_mismatch_string: fn(Result[string, DecodeError], string, string, string) -> void =
    fn(result: Result[string, DecodeError], expected_field: string, expected_actual: string, message: string) -> void {
        match result {
            Ok(_) => { assert(false, std.string.concat(message, ": expected Err, got Ok")) }
            Err(TypeMismatch { field: f, expected: _, actual: act, context: _ }) => {
                assert(std.string.equals(f, expected_field), std.string.concat(message, ": wrong field name"))
                assert(std.string.equals(act, expected_actual), std.string.concat(message, ": wrong actual type"))
            }
            Err(_) => { assert(false, std.string.concat(message, ": expected TypeMismatch, got different error")) }
        }
        return
    }

// =============================================================================
// Test: required_string
// =============================================================================

let test_required_string_happy_path: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"Alice\"}")
    let result: string = assert_ok_string(required_string(json, "name"), "required_string happy path")
    assert_str_eq(result, "Alice", "required_string should return 'Alice'")
    return
}

let test_required_string_empty_value: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"\"}")
    let result: string = assert_ok_string(required_string(json, "name"), "required_string empty string")
    assert_str_eq(result, "", "required_string should return empty string")
    return
}

let test_required_string_missing_field: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"age\": 30}")
    assert_missing_field(required_string(json, "name"), "name", "required_string missing field")
    return
}

let test_required_string_wrong_type_number: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": 42}")
    assert_type_mismatch_string(required_string(json, "name"), "name", "number", "required_string wrong type number")
    return
}

let test_required_string_wrong_type_bool: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": true}")
    assert_type_mismatch_string(required_string(json, "name"), "name", "boolean", "required_string wrong type bool")
    return
}

let test_required_string_wrong_type_null: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": null}")
    assert_type_mismatch_string(required_string(json, "name"), "name", "null", "required_string wrong type null")
    return
}

let test_required_string_wrong_type_array: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": [1, 2]}")
    assert_type_mismatch_string(required_string(json, "name"), "name", "array", "required_string wrong type array")
    return
}

let test_required_string_wrong_type_object: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": {}}")
    assert_type_mismatch_string(required_string(json, "name"), "name", "object", "required_string wrong type object")
    return
}

// =============================================================================
// Test: required_number
// =============================================================================

let test_required_number_happy_path: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"score\": 3.14}")
    let result: f64 = assert_ok_f64(required_number(json, "score"), "required_number happy path")
    assert(result == 3.14, "required_number should return 3.14")
    return
}

let test_required_number_integer_value: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"count\": 42}")
    let result: f64 = assert_ok_f64(required_number(json, "count"), "required_number integer value")
    assert(result == 42.0, "required_number should return 42.0")
    return
}

let test_required_number_zero: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"value\": 0}")
    let result: f64 = assert_ok_f64(required_number(json, "value"), "required_number zero")
    assert(result == 0.0, "required_number should return 0.0")
    return
}

let test_required_number_negative: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"temp\": -10.5}")
    let result: f64 = assert_ok_f64(required_number(json, "temp"), "required_number negative")
    assert(result == -10.5, "required_number should return -10.5")
    return
}

let test_required_number_missing: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"Alice\"}")
    let result: Result[f64, DecodeError] = required_number(json, "score")
    match result {
        Ok(_) => { assert(false, "required_number missing: expected Err") }
        Err(MissingField { field: f, context: _ }) => {
            assert(std.string.equals(f, "score"), "required_number missing: wrong field")
        }
        Err(_) => { assert(false, "required_number missing: expected MissingField") }
    }
    return
}

let test_required_number_wrong_type: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"score\": \"high\"}")
    let result: Result[f64, DecodeError] = required_number(json, "score")
    match result {
        Ok(_) => { assert(false, "required_number wrong type: expected Err") }
        Err(TypeMismatch { field: f, expected: exp, actual: act, context: _ }) => {
            assert(std.string.equals(f, "score"), "required_number wrong type: wrong field")
            assert(std.string.equals(exp, "number"), "required_number wrong type: wrong expected")
            assert(std.string.equals(act, "string"), "required_number wrong type: wrong actual")
        }
        Err(_) => { assert(false, "required_number wrong type: expected TypeMismatch") }
    }
    return
}

