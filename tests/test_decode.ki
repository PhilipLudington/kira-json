// =============================================================================
// Test: format_decode_error
// =============================================================================

let test_format_missing_field_no_context: fn() -> void = fn() -> void {
    let err: DecodeError = MissingField { field: "email", context: "" }
    let msg: string = format_decode_error(err)
    assert_str_eq(msg, "Missing required field 'email'", "format MissingField without context")
    return
}

let test_format_missing_field_with_context: fn() -> void = fn() -> void {
    let err: DecodeError = MissingField { field: "email", context: "User" }
    let msg: string = format_decode_error(err)
    assert_str_eq(msg, "Missing required field 'email' in User", "format MissingField with context")
    return
}

let test_format_type_mismatch_no_context: fn() -> void = fn() -> void {
    let err: DecodeError = TypeMismatch { field: "age", expected: "number", actual: "string", context: "" }
    let msg: string = format_decode_error(err)
    assert_str_eq(msg, "Type mismatch for field 'age': expected number, got string", "format TypeMismatch without context")
    return
}

let test_format_type_mismatch_with_context: fn() -> void = fn() -> void {
    let err: DecodeError = TypeMismatch { field: "age", expected: "number", actual: "string", context: "User" }
    let msg: string = format_decode_error(err)
    assert_str_eq(msg, "Type mismatch for field 'age' in User: expected number, got string", "format TypeMismatch with context")
    return
}

let test_format_invalid_value_no_context: fn() -> void = fn() -> void {
    let err: DecodeError = InvalidValue { field: "status", message: "unknown status 'xyz'", context: "" }
    let msg: string = format_decode_error(err)
    assert_str_eq(msg, "Invalid value for field 'status': unknown status 'xyz'", "format InvalidValue without context")
    return
}

let test_format_invalid_value_with_context: fn() -> void = fn() -> void {
    let err: DecodeError = InvalidValue { field: "status", message: "unknown status 'xyz'", context: "Order" }
    let msg: string = format_decode_error(err)
    assert_str_eq(msg, "Invalid value for field 'status' in Order: unknown status 'xyz'", "format InvalidValue with context")
    return
}

// =============================================================================
// Test: empty object
// =============================================================================

let test_required_string_from_empty_object: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{}")
    let result: Result[string, DecodeError] = required_string(json, "anything")
    match result {
        Ok(_) => { assert(false, "required_string from empty: expected Err") }
        Err(MissingField { field: f, context: _ }) => {
            assert(std.string.equals(f, "anything"), "field should be 'anything'")
        }
        Err(_) => { assert(false, "expected MissingField from empty object") }
    }
    return
}

let test_optional_string_from_empty_object: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{}")
    let result: Option[string] = optional_string(json, "anything")
    match result {
        Some(_) => { assert(false, "optional_string from empty: expected None") }
        None => { return }
    }
    return
}

// =============================================================================
// Test: multiple fields in same object
// =============================================================================

let test_multiple_required_fields: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"Alice\", \"age\": 30, \"active\": true, \"score\": 9.5}")
    let name: string = assert_ok_string(required_string(json, "name"), "multi: name")
    let age: i64 = assert_ok_i64(required_int(json, "age"), "multi: age")
    let active: bool = assert_ok_bool(required_bool(json, "active"), "multi: active")
    let score: f64 = assert_ok_f64(required_number(json, "score"), "multi: score")
    assert_str_eq(name, "Alice", "multi: name should be Alice")
    assert(age == 30, "multi: age should be 30")
    assert(active == true, "multi: active should be true")
    assert(score == 9.5, "multi: score should be 9.5")
    return
}

let test_mix_required_and_optional: fn() -> void = fn() -> void {
    let json: Json = parse_ok("{\"name\": \"Bob\", \"age\": 25}")
    let name: string = assert_ok_string(required_string(json, "name"), "mix: name")
    let age: i64 = assert_ok_i64(required_int(json, "age"), "mix: age")
    let nickname: Option[string] = optional_string(json, "nickname")
    let score: Option[f64] = optional_number(json, "score")
    assert_str_eq(name, "Bob", "mix: name should be Bob")
    assert(age == 25, "mix: age should be 25")
    match nickname {
        Some(_) => { assert(false, "mix: nickname should be None") }
        None => { return }
    }
    return
}

