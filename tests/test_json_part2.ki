            assert(is_array(json), "should be an array")
        }
        Err(_) => { assert(false, "should succeed") }
    }
    return
}

// --- Unicode Edge Cases ---
// Note: Using JSON escape sequences instead of raw Unicode literals
// due to interpreter limitations with multi-byte character handling

let test_edge_unicode_escape_basic: fn() -> void = fn() -> void {
    // Arrange - basic unicode escapes in string
    let input: string = "\"\\u0041\\u0042\\u0043\""  // "ABC"

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_ok_json(result, "unicode escapes should parse")
    match result {
        Ok(json) => {
            match as_string(json) {
                Some(s) => {
                    assert(std.string.equals(s, "ABC"), "should decode to 'ABC'")
                }
                None => { assert(false, "should be a string") }
            }
        }
        Err(_) => { assert(false, "should succeed") }
    }
    return
}

let test_edge_unicode_escape_non_ascii: fn() -> void = fn() -> void {
    // Arrange - non-ASCII unicode escape (copyright symbol U+00A9)
    let input: string = "\"\\u00A9\""  // ©

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_ok_json(result, "non-ASCII unicode escape should parse")
    return
}

let test_edge_unicode_escape_cjk: fn() -> void = fn() -> void {
    // Arrange - CJK character (U+4E2D = 中)
    let input: string = "\"\\u4E2D\""

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_ok_json(result, "CJK unicode escape should parse")
    return
}

