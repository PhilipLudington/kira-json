// --- Required Fields Tests ---

let test_schema_required_present: fn() -> void = fn() -> void {
    // Arrange
    let json_result: Result[Json, JsonError] = parse("{\"name\": \"Alice\", \"age\": 30}")
    var json: Json = JNull
    match json_result {
        Ok(j) => { json = j }
        Err(_) => { assert(false, "parse should succeed") }
    }
    let schema: Schema = schema_object(Some(Cons("name", Cons("age", Nil))), None)

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_ok_schema(result, "all required fields present")
    return
}

let test_schema_required_missing: fn() -> void = fn() -> void {
    // Arrange
    let json_result: Result[Json, JsonError] = parse("{\"name\": \"Alice\"}")
    var json: Json = JNull
    match json_result {
        Ok(j) => { json = j }
        Err(_) => { assert(false, "parse should succeed") }
    }
    let schema: Schema = schema_object(Some(Cons("name", Cons("age", Nil))), None)

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_err_schema(result, "missing required field should fail")
    match result {
        Err(errors) => {
            match errors {
                Cons(MissingRequired { field: f, path: _ }, _) => {
                    assert(std.string.equals(f, "age"), "missing field should be 'age'")
                }
                _ => { assert(false, "should be MissingRequired error") }
            }
        }
        Ok(_) => { }
    }
    return
}

let test_schema_required_multiple_missing: fn() -> void = fn() -> void {
    // Arrange
    let json: Json = json_object_empty()
    let schema: Schema = schema_object(Some(Cons("a", Cons("b", Nil))), None)

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_err_schema(result, "missing required fields should fail")
    match result {
        Err(errors) => {
            // Should have two errors
            match errors {
                Cons(_, Cons(_, Nil)) => { }
                _ => { assert(false, "should have exactly two errors") }
            }
        }
        Ok(_) => { }
    }
    return
}

