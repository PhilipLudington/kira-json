}

// --- Stringify Determinism Tests ---

let test_stringify_determinism_same_output: fn() -> void = fn() -> void {
    // Arrange
    let field1: JsonField = JsonField { key: "a", value: JNumber(1.0) }
    let field2: JsonField = JsonField { key: "b", value: JString("test") }
    let json: Json = json_object(Cons(field1, Cons(field2, Nil)))

    // Act
    let output1: string = stringify(json)
    let output2: string = stringify(json)

    // Assert
    assert(std.string.equals(output1, output2), "same input should produce same output")
    return
}

let test_stringify_determinism_nested: fn() -> void = fn() -> void {
    // Arrange - complex nested structure
    let inner: Json = JArray(Cons(JBool(true), Cons(JNull, Nil)))
    let field: JsonField = JsonField { key: "nested", value: inner }
    let json: Json = json_object(Cons(field, Nil))

    // Act
    let output1: string = stringify(json)
    let output2: string = stringify(json)
    let output3: string = stringify(json)

    // Assert
    assert(std.string.equals(output1, output2), "first two outputs should match")
    assert(std.string.equals(output2, output3), "second and third outputs should match")
    return
}

// --- Parse Consistency Tests ---

let test_parse_consistency_valid_never_crashes: fn() -> void = fn() -> void {
    // Arrange - various valid JSON inputs
    let inputs: List[string] = Cons("null",
        Cons("true",
        Cons("false",
        Cons("0",
        Cons("-1",
        Cons("3.14",
        Cons("1e10",
        Cons("\"\"",
        Cons("\"hello\"",
        Cons("[]",
        Cons("[1,2,3]",
        Cons("{}",
        Cons("{\"a\":1}",
        Nil)))))))))))))

    // Act & Assert - all should parse successfully
    check_valid_parses(inputs)
    return
}

let test_parse_consistency_invalid_never_crashes: fn() -> void = fn() -> void {
    // Arrange - various invalid JSON inputs
    let inputs: List[string] = Cons("",
        Cons("{",
        Cons("}",
        Cons("[",
        Cons("]",
        Cons("\"unterminated",
        Cons("nul",
        Cons("tru",
        Cons("fals",
        Cons("1.",
        Cons(".5",
        Cons("01",
        Cons("{\"a\"}",
        Nil)))))))))))))

    // Act & Assert - all should return errors (not crash)
    check_invalid_parses(inputs)
    return
}

