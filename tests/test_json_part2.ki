let test_json_null: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_null()

    // Assert
    assert(is_null(j), "json_null should create JNull")
    return
}

let test_json_bool_true: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_bool(true)

    // Assert
    assert(is_bool(j), "json_bool should create JBool")
    match as_bool(j) {
        Some(v) => { assert(v, "value should be true") }
        None => { assert(false, "as_bool should return Some") }
    }
    return
}

let test_json_bool_false: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_bool(false)

    // Assert
    match as_bool(j) {
        Some(v) => { assert(not v, "value should be false") }
        None => { assert(false, "as_bool should return Some") }
    }
    return
}

let test_json_number: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_number(3.14)

    // Assert
    assert(is_number(j), "json_number should create JNumber")
    match as_number(j) {
        Some(v) => { assert(v > 3.13, "value should be close to 3.14") }
        None => { assert(false, "as_number should return Some") }
    }
    return
}

let test_json_int: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_int(42)

    // Assert
    assert(is_number(j), "json_int should create JNumber")
    match as_int(j) {
        Some(v) => { assert(v == 42, "value should be 42") }
        None => { assert(false, "as_int should return Some") }
    }
    return
}

let test_json_string: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_string("hello")

    // Assert
    assert(is_string(j), "json_string should create JString")
    match as_string(j) {
        Some(v) => { assert(std.string.equals(v, "hello"), "value should be 'hello'") }
        None => { assert(false, "as_string should return Some") }
    }
    return
}

let test_json_array: fn() -> void = fn() -> void {
    // Arrange
    let items: List[Json] = Cons(json_int(1), Cons(json_int(2), Nil))

    // Act
    let j: Json = json_array(items)

    // Assert
    assert(is_array(j), "json_array should create JArray")
    match size(j) {
        Some(s) => { assert_i32_eq(s, 2, "array should have 2 elements") }
        None => { assert(false, "size should return Some") }
    }
    return
}

let test_json_array_empty: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_array_empty()

    // Assert
    assert(is_array(j), "json_array_empty should create JArray")
    match size(j) {
        Some(s) => { assert_i32_eq(s, 0, "array should be empty") }
        None => { assert(false, "size should return Some") }
    }
    return
}

let test_json_object: fn() -> void = fn() -> void {
    // Arrange
    let fields: List[JsonField] = Cons(
        make_field("name", json_string("Alice")),
        Nil
    )

    // Act
    let j: Json = json_object(fields)

    // Assert
    assert(is_object(j), "json_object should create JObject")
    match get_field(j, "name") {
        Some(v) => {
            match as_string(v) {
                Some(s) => { assert(std.string.equals(s, "Alice"), "name should be Alice") }
                None => { assert(false, "name should be a string") }
            }
        }
        None => { assert(false, "object should have name field") }
    }
    return
}

let test_json_object_empty: fn() -> void = fn() -> void {
    // Act
    let j: Json = json_object_empty()

    // Assert
    assert(is_object(j), "json_object_empty should create JObject")
    match size(j) {
        Some(s) => { assert_i32_eq(s, 0, "object should be empty") }
        None => { assert(false, "size should return Some") }
    }
    return
}

