    // Act
    let j: Json = build(builder())

    // Assert
    assert(is_object(j), "builder should create an object")
    match size(j) {
        Some(s) => { assert_i32_eq(s, 0, "object should be empty") }
        None => { assert(false, "size should return Some") }
    }
    return
}

let test_builder_with_string: fn() -> void = fn() -> void {
    // Act
    let j: Json = build(with_string(builder(), "name", "Bob"))

    // Assert
