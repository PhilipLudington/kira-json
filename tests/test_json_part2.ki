        max_depth: 128,
        max_string_length: None,
        max_array_items: Some(3),
        max_object_fields: None
    }
    let result: Result[Json, JsonError] = parse_with_limits("[1, 2, 3, 4, 5]", limits)
    match result {
        Ok(_) => { assert_true(false, "should have failed with TooManyArrayItems") }
