let test_builder_chained: fn() -> void = fn() -> void {
    // Act
    let b1: JsonBuilder = builder()
    let b2: JsonBuilder = with_string(b1, "name", "Charlie")
    let b3: JsonBuilder = with_int(b2, "age", 30)
    let b4: JsonBuilder = with_bool(b3, "active", true)
    let j: Json = build(b4)

    // Assert
    match size(j) {
        Some(s) => { assert_i32_eq(s, 3, "object should have 3 fields") }
        None => { assert(false, "size should return Some") }
    }
    match get_field(j, "name") {
        Some(v) => {
            match as_string(v) {
                Some(s) => { assert(std.string.equals(s, "Charlie"), "name should be Charlie") }
                None => { assert(false, "name should be a string") }
            }
        }
        None => { assert(false, "object should have name field") }
    }
    return
}

let test_builder_preserves_order: fn() -> void = fn() -> void {
    // Act - add fields in order: a, b, c
    let b1: JsonBuilder = builder()
    let b2: JsonBuilder = with_string(b1, "a", "first")
    let b3: JsonBuilder = with_string(b2, "b", "second")
    let b4: JsonBuilder = with_string(b3, "c", "third")
    let j: Json = build(b4)

    // Assert - stringify and check order
    let s: string = stringify(j)
    // Should have a before b before c
    let a_pos: i32 = find_substring(s, "\"a\"")
    let b_pos: i32 = find_substring(s, "\"b\"")
    let c_pos: i32 = find_substring(s, "\"c\"")
    assert(a_pos < b_pos, "a should come before b")
    assert(b_pos < c_pos, "b should come before c")
    return
}

let test_builder_nested_object: fn() -> void = fn() -> void {
    // Act
    let inner: JsonBuilder = with_string(builder(), "city", "NYC")
    let outer: JsonBuilder = with_object(builder(), "address", inner)
    let j: Json = build(outer)

    // Assert
    match get_field(j, "address") {
        Some(addr) => {
            assert(is_object(addr), "address should be an object")
            match get_field(addr, "city") {
                Some(city) => {
                    match as_string(city) {
                        Some(s) => { assert(std.string.equals(s, "NYC"), "city should be NYC") }
                        None => { assert(false, "city should be a string") }
                    }
                }
                None => { assert(false, "address should have city field") }
            }
        }
        None => { assert(false, "object should have address field") }
    }
    return
}

/// Helper to find substring position (returns -1 if not found)
let find_substring: fn(string, string) -> i32 = fn(haystack: string, needle: string) -> i32 {
    let hlen: i32 = to_int(std.string.length(haystack))
    let nlen: i32 = to_int(std.string.length(needle))
    if nlen > hlen {
        return -1
    }
    return find_substring_at(haystack, needle, 0, hlen - nlen + 1, nlen)
}

let find_substring_at: fn(string, string, i32, i32, i32) -> i32 =
    fn(haystack: string, needle: string, pos: i32, limit: i32, nlen: i32) -> i32 {
        if pos >= limit {
            return -1
        }
        let pos64: i64 = pos + 0i64
        let end64: i64 = pos64 + nlen + 0i64
        match std.string.substring(haystack, pos64, end64) {
            None => { return -1 }
            Some(sub) => {
                if std.string.equals(sub, needle) {
                    return pos
                }
                return find_substring_at(haystack, needle, pos + 1, limit, nlen)
            }
        }
    }

// =============================================================================
// Error Context Tests
// =============================================================================

let test_format_error_with_context_single_line: fn() -> void = fn() -> void {
    // Arrange
    let input: string = "{\"key\": value}"
    let result: Result[Json, JsonError] = parse(input)

    // Act & Assert
    match result {
        Err(e) => {
            let msg: string = format_error_with_context(input, e)
            // Should contain the line content
            assert(std.string.contains(msg, "{\"key\": value}"), "should contain input line")
            // Should contain a caret indicator
            assert(std.string.contains(msg, "^"), "should contain caret indicator")
        }
        Ok(_) => { assert(false, "parse should fail") }
    }
    return
}

let test_format_error_with_context_multiline: fn() -> void = fn() -> void {
    // Arrange
    let input: string = "{\n  \"key\": value\n}"
    let result: Result[Json, JsonError] = parse(input)

    // Act & Assert
    match result {
        Err(e) => {
            let msg: string = format_error_with_context(input, e)
            // Should contain the error line content (the line with "value")
            assert(std.string.contains(msg, "\"key\": value"), "should contain error line")
            assert(std.string.contains(msg, "^"), "should contain caret indicator")
        }
        Ok(_) => { assert(false, "parse should fail") }
    }
    return
}

let test_format_error_with_context_unterminated_string: fn() -> void = fn() -> void {
    // Arrange
    let input: string = "{\"key\": \"unterminated"
    let result: Result[Json, JsonError] = parse(input)

    // Act & Assert
    match result {
        Err(e) => {
            let msg: string = format_error_with_context(input, e)
            assert(std.string.contains(msg, "Unterminated"), "should mention unterminated")
            assert(std.string.contains(msg, "^"), "should contain caret indicator")
        }
        Ok(_) => { assert(false, "parse should fail") }
    }
    return
}

