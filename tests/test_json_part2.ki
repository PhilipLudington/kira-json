let test_schema_enum_valid: fn() -> void = fn() -> void {
    // Arrange
    let json: Json = JString("red")
    let allowed: List[Json] = Cons(JString("red"), Cons(JString("green"), Cons(JString("blue"), Nil)))
    let schema: Schema = schema_enum(allowed)

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_ok_schema(result, "value in enum should pass")
    return
}

let test_schema_enum_invalid: fn() -> void = fn() -> void {
    // Arrange
    let json: Json = JString("yellow")
    let allowed: List[Json] = Cons(JString("red"), Cons(JString("green"), Cons(JString("blue"), Nil)))
    let schema: Schema = schema_enum(allowed)

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_err_schema(result, "value not in enum should fail")
    match result {
        Err(errors) => {
            match errors {
                Cons(EnumViolation { path: _ }, _) => { }
                _ => { assert(false, "should be EnumViolation error") }
            }
        }
        Ok(_) => { }
    }
    return
}

// --- Nested Validation Tests ---

let test_schema_nested_object_valid: fn() -> void = fn() -> void {
    // Arrange
    let json_result: Result[Json, JsonError] = parse("{\"user\": {\"name\": \"Alice\", \"age\": 30}}")
    var json: Json = JNull
    match json_result {
        Ok(j) => { json = j }
        Err(_) => { assert(false, "parse should succeed") }
    }

    let user_schema: Schema = schema_object(
        Some(Cons("name", Nil)),
        Some(Cons(
            schema_property("name", schema_string(Some(1), None)),
            Cons(
                schema_property("age", schema_number(Some(0.0), Some(150.0))),
                Nil
            )
        ))
    )
    let schema: Schema = schema_object(
        Some(Cons("user", Nil)),
        Some(Cons(schema_property("user", user_schema), Nil))
    )

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_ok_schema(result, "valid nested object should pass")
    return
}

let test_schema_nested_object_invalid: fn() -> void = fn() -> void {
    // Arrange
    let json_result: Result[Json, JsonError] = parse("{\"user\": {\"name\": \"\", \"age\": 200}}")
    var json: Json = JNull
    match json_result {
        Ok(j) => { json = j }
        Err(_) => { assert(false, "parse should succeed") }
    }

    let user_schema: Schema = schema_object(
        None,
        Some(Cons(
            schema_property("name", schema_string(Some(1), None)),
            Cons(
                schema_property("age", schema_number(Some(0.0), Some(150.0))),
                Nil
            )
        ))
    )
    let schema: Schema = schema_object(
        None,
        Some(Cons(schema_property("user", user_schema), Nil))
    )

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_err_schema(result, "invalid nested object should fail")
    return
}

let test_schema_array_items_valid: fn() -> void = fn() -> void {
    // Arrange
    let json: Json = JArray(Cons(JNumber(1.0), Cons(JNumber(2.0), Cons(JNumber(3.0), Nil))))
    let item_schema: Schema = schema_number(Some(0.0), Some(10.0))
    let schema: Schema = schema_array(Some(item_schema), None, None)

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_ok_schema(result, "valid array items should pass")
    return
}

let test_schema_array_items_invalid: fn() -> void = fn() -> void {
    // Arrange
    let json: Json = JArray(Cons(JNumber(1.0), Cons(JNumber(20.0), Cons(JNumber(3.0), Nil))))
    let item_schema: Schema = schema_number(Some(0.0), Some(10.0))
    let schema: Schema = schema_array(Some(item_schema), None, None)

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_err_schema(result, "invalid array item should fail")
    match result {
        Err(errors) => {
            match errors {
                Cons(MaximumViolation { value: _, maximum: _, path: p }, _) => {
                    assert(std.string.equals(p, "$[1]"), "path should be $[1]")
                }
                _ => { assert(false, "should be MaximumViolation error") }
            }
        }
        Ok(_) => { }
    }
    return
}

// --- Multiple Error Collection Tests ---

let test_schema_collects_multiple_errors: fn() -> void = fn() -> void {
    // Arrange - object with multiple violations
    let json_result: Result[Json, JsonError] = parse("{\"count\": -5, \"name\": \"\"}")
    var json: Json = JNull
    match json_result {
        Ok(j) => { json = j }
        Err(_) => { assert(false, "parse should succeed") }
    }

    let schema: Schema = schema_object(
        Some(Cons("count", Cons("name", Cons("missing", Nil)))),  // missing field
        Some(Cons(
            schema_property("count", schema_number(Some(0.0), None)),  // minimum violation
            Cons(
                schema_property("name", schema_string(Some(1), None)),  // minLength violation
                Nil
            )
        ))
    )

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_err_schema(result, "should have multiple errors")
    match result {
        Err(errors) => {
            // Count errors
            let count: i32 = count_schema_errors(errors)
            assert(count >= 3, "should have at least 3 errors")
        }
        Ok(_) => { }
    }
    return
}

// --- Error Formatting Tests ---

let test_format_schema_error_type_mismatch: fn() -> void = fn() -> void {
    // Arrange
    let err: SchemaError = TypeMismatch { expected: "number", actual: "string", path: "$.age" }

    // Act
    let formatted: string = format_schema_error(err)

    // Assert
    assert(std.string.contains(formatted, "Type mismatch"), "should contain 'Type mismatch'")
    assert(std.string.contains(formatted, "number"), "should contain expected type")
    assert(std.string.contains(formatted, "string"), "should contain actual type")
    assert(std.string.contains(formatted, "$.age"), "should contain path")
    return
}

let test_format_schema_errors_multiple: fn() -> void = fn() -> void {
    // Arrange
    let errors: List[SchemaError] = Cons(
        MissingRequired { field: "name", path: "$" },
        Cons(
            MinimumViolation { value: -5.0, minimum: 0.0, path: "$.count" },
            Nil
        )
    )

    // Act
    let formatted: string = format_schema_errors(errors)

    // Assert
    assert(std.string.contains(formatted, "Missing required"), "should contain first error")
    assert(std.string.contains(formatted, "Minimum violation"), "should contain second error")
    return
}

// --- Schema Any Tests ---

let test_schema_any_accepts_all_types: fn() -> void = fn() -> void {
    // Arrange
    let schema: Schema = schema_any()

    // Act & Assert - should accept all types
    assert_ok_schema(validate(JNull, schema), "should accept null")
    assert_ok_schema(validate(JBool(true), schema), "should accept bool")
    assert_ok_schema(validate(JNumber(42.0), schema), "should accept number")
    assert_ok_schema(validate(JString("hi"), schema), "should accept string")
    assert_ok_schema(validate(JArray(Nil), schema), "should accept array")
    assert_ok_schema(validate(json_object_empty(), schema), "should accept object")
    return
}

// =============================================================================
// Resource Limit Tests
// =============================================================================

/// Test that default limits are reasonable
let test_default_limits_values: fn() -> void = fn() -> void {
    let limits: ParseLimits = default_limits()
    assert_true(limits.max_depth == 128, "default max_depth should be 128")
    match limits.max_string_length {
        Some(n) => { assert_true(n == 10000000, "default max_string_length should be 10000000") }
        None => { assert_true(false, "default max_string_length should have a value") }
    }
    match limits.max_array_items {
        Some(n) => { assert_true(n == 1000000, "default max_array_items should be 1000000") }
        None => { assert_true(false, "default max_array_items should have a value") }
    }
    match limits.max_object_fields {
        Some(n) => { assert_true(n == 100000, "default max_object_fields should be 100000") }
        None => { assert_true(false, "default max_object_fields should have a value") }
    }
    return
}

/// Test that unlimited limits have None for optional fields
let test_unlimited_limits_values: fn() -> void = fn() -> void {
    let limits: ParseLimits = unlimited_limits()
    assert_true(limits.max_depth == 128, "unlimited max_depth should still be 128")
    match limits.max_string_length {
        Some(_) => { assert_true(false, "unlimited max_string_length should be None") }
        None => { }
    }
    match limits.max_array_items {
        Some(_) => { assert_true(false, "unlimited max_array_items should be None") }
        None => { }
    }
    match limits.max_object_fields {
        Some(_) => { assert_true(false, "unlimited max_object_fields should be None") }
        None => { }
    }
    return
}

/// Test that string too long error is returned when limit exceeded
let test_string_too_long_error: fn() -> void = fn() -> void {
    // Create limits with a very small string length limit
    let limits: ParseLimits = ParseLimits {
        max_depth: 128,
        max_string_length: Some(5),
        max_array_items: None,
        max_object_fields: None
    }
    let result: Result[Json, JsonError] = parse_with_limits("\"hello world\"", limits)
    match result {
        Ok(_) => { assert_true(false, "should have failed with StringTooLong") }
        Err(err) => {
            match err {
                StringTooLong { length: len, max_length: max, line: _, col: _ } => {
                    assert_true(len > max, "length should exceed max")
                    assert_true(max == 5, "max should be 5")
                }
                _ => { assert_true(false, "expected StringTooLong error") }
            }
        }
    }
    return
}

/// Test that string within limit is accepted
let test_string_within_limit: fn() -> void = fn() -> void {
    let limits: ParseLimits = ParseLimits {
        max_depth: 128,
        max_string_length: Some(20),
        max_array_items: None,
        max_object_fields: None
    }
    let result: Result[Json, JsonError] = parse_with_limits("\"hello\"", limits)
    assert_ok_json(result, "string within limit should be accepted")
    return
}

/// Test that too many array items error is returned
