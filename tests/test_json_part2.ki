let test_roundtrip_negative_number: fn() -> void = fn() -> void {
    // Arrange
    let original: Json = JNumber(-123.456)

    // Act
    let serialized: string = stringify(original)
    let reparsed: Result[Json, JsonError] = parse(serialized)

    // Assert
    match reparsed {
        Ok(json) => {
            match as_number(json) {
                Some(n) => {
                    // Allow small floating point difference
                    let diff: f64 = n - (-123.456)
                    assert(diff > -0.001 and diff < 0.001, "negative number should roundtrip")
                }
                None => { assert(false, "should be a number") }
            }
        }
        Err(_) => { assert(false, "roundtrip should succeed") }
    }
    return
}

