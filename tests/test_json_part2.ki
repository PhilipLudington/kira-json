//! Tests for the JSON library - Part 2
//! Builder, edge case, property, schema, and limits tests.

module test_json_part2

// Core types and predicates
import json.types.{ Json, JsonField, JsonError, ParseLimits, default_limits, unlimited_limits, format_error, format_error_with_context, error_line, error_column, error_byte_position, is_null, is_bool, is_number, is_string, is_array, is_object, type_name, as_string, as_number, as_int, as_bool, as_array, as_object, get_field, get_index, size, keys, values, default_max_depth, make_field, Schema, SchemaProperty, SchemaError, format_schema_error, format_schema_errors }

// Parser
import json.parser.{ parse, parse_with_max_depth, parse_strict, parse_strict_with_max_depth, parse_with_limits, parse_strict_with_limits }

// Serializer
import json.serializer.{ stringify, stringify_pretty }

// Transformations
import json.transform.{ set_field, remove_field, merge, map_array, filter_array, filter_fields }

// Equality
import json.equality.{ equals }

// Path operations
import json.path.{ get_path, set_path, has_path, remove_path }

// Builder and constructors
import json.builder.{ json_null, json_bool, json_number, json_int, json_string, json_array, json_array_empty, json_object, json_object_empty, JsonBuilder, builder, build, with_field, with_string, with_number, with_int, with_bool, with_null, with_array, with_object }

// Schema validation
import json.schema.{ validate, schema_any, schema_type, schema_string, schema_number, schema_integer, schema_array, schema_object, schema_property, schema_ref, schema_enum }

// =============================================================================
// Test Utilities
// =============================================================================

/// Asserts that a condition is true, with a message.
let assert_true: fn(bool, string) -> void = fn(condition: bool, message: string) -> void {
    assert(condition, message)
    return
}

/// Asserts that two strings are equal.
let assert_str_eq: fn(string, string, string) -> void =
    fn(actual: string, expected: string, message: string) -> void {
        assert(std.string.equals(actual, expected), message)
        return
    }

/// Asserts that two i32 values are equal.
let assert_i32_eq: fn(i32, i32, string) -> void =
    fn(actual: i32, expected: i32, message: string) -> void {
        assert(actual == expected, message)
        return
    }

/// Asserts that two f64 values are equal.
let assert_f64_eq: fn(f64, f64, string) -> void =
    fn(actual: f64, expected: f64, message: string) -> void {
        assert(actual == expected, message)
        return
    }

/// Asserts that an Option[Json] is Some.
let assert_some_json: fn(Option[Json], string) -> void = fn(opt: Option[Json], message: string) -> void {
    match opt {
        Some(_) => { return }
        None => { assert(false, message) }
    }
    return
}

/// Asserts that an Option[List[Json]] is Some.
let assert_some_json_list: fn(Option[List[Json]], string) -> void = fn(opt: Option[List[Json]], message: string) -> void {
    match opt {
        Some(_) => { return }
        None => { assert(false, message) }
    }
    return
}

/// Asserts that an Option[List[JsonField]] is Some.
let assert_some_field_list: fn(Option[List[JsonField]], string) -> void = fn(opt: Option[List[JsonField]], message: string) -> void {
    match opt {
        Some(_) => { return }
        None => { assert(false, message) }
    }
    return
}

/// Asserts that an Option[List[string]] is Some.
let assert_some_string_list: fn(Option[List[string]], string) -> void = fn(opt: Option[List[string]], message: string) -> void {
    match opt {
        Some(_) => { return }
        None => { assert(false, message) }
    }
    return
}

/// Asserts that an Option[Json] is None.
let assert_none_json: fn(Option[Json], string) -> void = fn(opt: Option[Json], message: string) -> void {
    match opt {
        Some(_) => { assert(false, message) }
        None => { return }
    }
    return
}

/// Asserts that an Option[string] is None.
let assert_none_string: fn(Option[string], string) -> void = fn(opt: Option[string], message: string) -> void {
    match opt {
        Some(_) => { assert(false, message) }
        None => { return }
    }
    return
}

/// Asserts that an Option[f64] is None.
let assert_none_f64: fn(Option[f64], string) -> void = fn(opt: Option[f64], message: string) -> void {
    match opt {
        Some(_) => { assert(false, message) }
        None => { return }
    }
    return
}

/// Asserts that an Option[i64] is None.
let assert_none_i64: fn(Option[i64], string) -> void = fn(opt: Option[i64], message: string) -> void {
    match opt {
        Some(_) => { assert(false, message) }
        None => { return }
    }
    return
}

/// Asserts that an Option[List[string]] is None.
let assert_none_string_list: fn(Option[List[string]], string) -> void = fn(opt: Option[List[string]], message: string) -> void {
    match opt {
        Some(_) => { assert(false, message) }
        None => { return }
    }
    return
}

/// Asserts that a Result[Json, JsonError] is Ok.
let assert_ok_json: fn(Result[Json, JsonError], string) -> void = fn(result: Result[Json, JsonError], message: string) -> void {
    match result {
        Ok(_) => { return }
        Err(_) => { assert(false, message) }
    }
    return
}

/// Asserts that a Result[bool, List[SchemaError]] is Ok.
let assert_ok_schema: fn(Result[bool, List[SchemaError]], string) -> void = fn(result: Result[bool, List[SchemaError]], message: string) -> void {
    match result {
        Ok(_) => { return }
        Err(_) => { assert(false, message) }
    }
    return
}

/// Asserts that a Result[Json, JsonError] is Err.
let assert_err_json: fn(Result[Json, JsonError], string) -> void = fn(result: Result[Json, JsonError], message: string) -> void {
    match result {
        Ok(_) => { assert(false, message) }
        Err(_) => { return }
    }
    return
}

/// Asserts that a Result[bool, List[SchemaError]] is Err.
let assert_err_schema: fn(Result[bool, List[SchemaError]], string) -> void = fn(result: Result[bool, List[SchemaError]], message: string) -> void {
    match result {
        Ok(_) => { assert(false, message) }
        Err(_) => { return }
    }
    return
}

/// Checks that each string in the list parses successfully.
let check_valid_parses: fn(List[string]) -> void = fn(list: List[string]) -> void {
    match list {
        Nil => { return }
        Cons(input, rest) => {
            let result: Result[Json, JsonError] = parse(input)
            assert_ok_json(result, "valid JSON should always parse")
            check_valid_parses(rest)
        }
    }
}

/// Checks that each string in the list does not crash (error is expected).
let check_invalid_parses: fn(List[string]) -> void = fn(list: List[string]) -> void {
    match list {
        Nil => { return }
        Cons(input, rest) => {
            let result: Result[Json, JsonError] = parse(input)
            // We just want to verify it doesn't crash - error is expected
            match result {
                Ok(_) => { }
                Err(_) => { }
            }
            check_invalid_parses(rest)
        }
    }
}

/// Counts the number of errors in a list of SchemaErrors.
let count_schema_errors: fn(List[SchemaError]) -> i32 = fn(errs: List[SchemaError]) -> i32 {
    match errs {
        Nil => { return 0 }
        Cons(_, rest) => { return 1 + count_schema_errors(rest) }
    }
}

