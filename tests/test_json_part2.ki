// --- Empty and Whitespace Input ---

let test_edge_empty_input: fn() -> void = fn() -> void {
    // Arrange
    let input: string = ""

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_err_json(result, "empty input should fail")
    match result {
        Err(UnexpectedEof { expected: _, context: _, line: _, col: _ }) => { return }
        _ => { assert(false, "should be UnexpectedEof error") }
    }
    return
}

let test_edge_whitespace_only_spaces: fn() -> void = fn() -> void {
    // Arrange
    let input: string = "   "

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_err_json(result, "whitespace-only input should fail")
    return
}

let test_edge_whitespace_only_tabs: fn() -> void = fn() -> void {
    // Arrange
    let input: string = "\t\t\t"

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_err_json(result, "tab-only input should fail")
    return
}

let test_edge_whitespace_only_newlines: fn() -> void = fn() -> void {
    // Arrange
    let input: string = "\n\n\n"

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_err_json(result, "newline-only input should fail")
    return
}

let test_edge_whitespace_only_mixed: fn() -> void = fn() -> void {
    // Arrange
    let input: string = "  \t\n \r\n  "

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_err_json(result, "mixed whitespace-only input should fail")
    return
}

// --- Maximum Nesting Depth ---

let test_edge_nesting_at_max_depth: fn() -> void = fn() -> void {
    // Arrange - build a structure with exactly 5 levels: [[[[[null]]]]]
    let input: string = "[[[[[null]]]]]"  // depth = 5

    // Act
    let result: Result[Json, JsonError] = parse_with_max_depth(input, 5)

    // Assert
    assert_ok_json(result, "nesting at exactly max depth should succeed")
    return
}

let test_edge_nesting_exceeds_max_depth: fn() -> void = fn() -> void {
    // Arrange - build a structure with 6 levels but limit is 5
    let input: string = "[[[[[[null]]]]]]"  // depth = 6

    // Act
    let result: Result[Json, JsonError] = parse_with_max_depth(input, 5)

    // Assert
    assert_err_json(result, "nesting exceeding max depth should fail")
    match result {
        Err(MaxDepthExceeded { depth: _, max_depth: _, line: _, col: _ }) => { return }
        _ => { assert(false, "should be MaxDepthExceeded error") }
    }
    return
}

let test_edge_nesting_objects_at_max_depth: fn() -> void = fn() -> void {
    // Arrange - nested objects at depth 3: {"a":{"a":{"a":null}}}
    let input: string = "{\"a\":{\"a\":{\"a\":null}}}"  // depth = 3

    // Act
    let result: Result[Json, JsonError] = parse_with_max_depth(input, 3)

    // Assert
    assert_ok_json(result, "object nesting at exactly max depth should succeed")
    return
}

let test_edge_nesting_mixed_at_max_depth: fn() -> void = fn() -> void {
    // Arrange - mixed array/object nesting: [{"a":[null]}]  depth = 3
    let input: string = "[{\"a\":[null]}]"

    // Act
    let result: Result[Json, JsonError] = parse_with_max_depth(input, 3)

    // Assert
    assert_ok_json(result, "mixed nesting at exactly max depth should succeed")
    return
}

// --- Long Strings ---

let test_edge_string_with_special_chars: fn() -> void = fn() -> void {
    // Arrange - a string with special characters
    let input: string = "\"Hello\\nWorld\\t!\\\"quote\\\"\\\\backslash\""

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_ok_json(result, "string with special chars should parse")
    match result {
        Ok(json) => {
            match as_string(json) {
                Some(s) => {
                    assert(std.string.contains(s, "\n"), "should contain newline")
                    assert(std.string.contains(s, "\t"), "should contain tab")
                }
                None => { assert(false, "should be a string") }
            }
        }
        Err(_) => { assert(false, "should succeed") }
    }
    return
}

let test_edge_string_with_unicode_escapes: fn() -> void = fn() -> void {
    // Arrange - a string with unicode escapes
    let input: string = "\"\\u0048\\u0065\\u006C\\u006C\\u006F\""  // "Hello"

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_ok_json(result, "string with unicode escapes should parse")
    match result {
        Ok(json) => {
            match as_string(json) {
                Some(s) => {
                    assert(std.string.equals(s, "Hello"), "should decode to 'Hello'")
                }
                None => { assert(false, "should be a string") }
            }
        }
        Err(_) => { assert(false, "should succeed") }
    }
    return
}

// --- Long Arrays ---

let test_edge_array_10_elements: fn() -> void = fn() -> void {
    // Arrange - array with 10 null elements
    // Note: Limited due to recursive interpreter implementation
    let input: string = "[null,null,null,null,null,null,null,null,null,null]"

    // Act
    let result: Result[Json, JsonError] = parse(input)

    // Assert
    assert_ok_json(result, "10 element array should parse")
    match result {
        Ok(json) => {
            assert(is_array(json), "should be an array")
        }
        Err(_) => { assert(false, "should succeed") }
    }
    return
}

let test_edge_array_mixed_types: fn() -> void = fn() -> void {
    // Arrange - array with 8 mixed elements (2 groups of 4 types)
