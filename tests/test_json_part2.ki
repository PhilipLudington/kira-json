/// Test parse_strict_with_limits combines strict mode with limits
let test_parse_strict_with_limits: fn() -> void = fn() -> void {
    let limits: ParseLimits = ParseLimits {
        max_depth: 128,
        max_string_length: None,
        max_array_items: Some(2),
        max_object_fields: None
    }
    // Test that strict mode works (duplicate keys rejected)
    let strict_result: Result[Json, JsonError] = parse_strict_with_limits("{\"a\": 1, \"a\": 2}", limits)
    match strict_result {
        Ok(_) => { assert_true(false, "strict mode should reject duplicate keys") }
        Err(err) => {
            match err {
                DuplicateKey { key: _, line: _, col: _ } => { }
                _ => { assert_true(false, "expected DuplicateKey error") }
            }
        }
    }
    // Test that limits work (too many array items)
    let limit_result: Result[Json, JsonError] = parse_strict_with_limits("[1, 2, 3]", limits)
    match limit_result {
        Ok(_) => { assert_true(false, "should have failed with TooManyArrayItems") }
        Err(err) => {
            match err {
                TooManyArrayItems { count: _, max_items: _, line: _, col: _ } => { }
                _ => { assert_true(false, "expected TooManyArrayItems error") }
            }
        }
    }
    return
}

/// Test error formatting for new error types
let test_format_error_string_too_long: fn() -> void = fn() -> void {
    let err: JsonError = StringTooLong { length: 100, max_length: 50, line: 1, col: 1 }
    let formatted: string = format_error(err)
    assert_true(std.string.contains(formatted, "String too long"), "should contain error description")
    assert_true(std.string.contains(formatted, "100"), "should contain actual length")
    assert_true(std.string.contains(formatted, "50"), "should contain max length")
    return
}

/// Test error formatting for array items error
let test_format_error_too_many_array_items: fn() -> void = fn() -> void {
    let err: JsonError = TooManyArrayItems { count: 10, max_items: 5, line: 2, col: 3 }
    let formatted: string = format_error(err)
    assert_true(std.string.contains(formatted, "Too many array items"), "should contain error description")
    assert_true(std.string.contains(formatted, "10"), "should contain actual count")
    assert_true(std.string.contains(formatted, "5"), "should contain max items")
    return
}

/// Test error formatting for object fields error
let test_format_error_too_many_object_fields: fn() -> void = fn() -> void {
    let err: JsonError = TooManyObjectFields { count: 20, max_fields: 10, line: 3, col: 4 }
    let formatted: string = format_error(err)
    assert_true(std.string.contains(formatted, "Too many object fields"), "should contain error description")
    assert_true(std.string.contains(formatted, "20"), "should contain actual count")
    assert_true(std.string.contains(formatted, "10"), "should contain max fields")
    return
}

/// Test error_line for new error types
let test_error_line_new_errors: fn() -> void = fn() -> void {
    assert_true(error_line(StringTooLong { length: 1, max_length: 1, line: 5, col: 1 }) == 5, "StringTooLong line")
    assert_true(error_line(TooManyArrayItems { count: 1, max_items: 1, line: 6, col: 1 }) == 6, "TooManyArrayItems line")
    assert_true(error_line(TooManyObjectFields { count: 1, max_fields: 1, line: 7, col: 1 }) == 7, "TooManyObjectFields line")
    return
}

/// Test error_column for new error types
let test_error_column_new_errors: fn() -> void = fn() -> void {
    assert_true(error_column(StringTooLong { length: 1, max_length: 1, line: 1, col: 10 }) == 10, "StringTooLong col")
    assert_true(error_column(TooManyArrayItems { count: 1, max_items: 1, line: 1, col: 11 }) == 11, "TooManyArrayItems col")
    assert_true(error_column(TooManyObjectFields { count: 1, max_fields: 1, line: 1, col: 12 }) == 12, "TooManyObjectFields col")
    return
}

/// Test empty containers work with any limits
let test_empty_containers_with_limits: fn() -> void = fn() -> void {
    let limits: ParseLimits = ParseLimits {
        max_depth: 128,
        max_string_length: Some(0),
        max_array_items: Some(0),
        max_object_fields: Some(0)
    }
    // Empty array should work (0 items)
    let arr_result: Result[Json, JsonError] = parse_with_limits("[]", limits)
    assert_ok_json(arr_result, "empty array should be accepted even with max_items=0")
    // Empty object should work (0 fields)
    let obj_result: Result[Json, JsonError] = parse_with_limits("{}", limits)
    assert_ok_json(obj_result, "empty object should be accepted even with max_fields=0")
    // Empty string should work (0 length)
    let str_result: Result[Json, JsonError] = parse_with_limits("\"\"", limits)
    assert_ok_json(str_result, "empty string should be accepted even with max_length=0")
    return
}

/// Test: error_byte_position returns Some for InvalidUtf8
let test_error_byte_position_invalid_utf8: fn() -> void = fn() -> void {
    let err: JsonError = InvalidUtf8 { byte_position: 42, error_kind: "InvalidStartByte" }
    match error_byte_position(err) {
        Some(pos) => { assert_true(pos == 42, "byte position should be 42") }
        None => { assert(false, "should return Some for InvalidUtf8") }
    }
    return
}

/// Test: error_byte_position returns None for other errors
let test_error_byte_position_other_errors: fn() -> void = fn() -> void {
    let err: JsonError = UnexpectedEof { expected: "value", context: "object", line: 1, col: 5 }
    match error_byte_position(err) {
        Some(_) => { assert(false, "should return None for non-InvalidUtf8 errors") }
        None => { return }
    }
    return
}

/// Test: format_error for InvalidUtf8
let test_format_error_invalid_utf8: fn() -> void = fn() -> void {
    let err: JsonError = InvalidUtf8 { byte_position: 10, error_kind: "InvalidStartByte" }
    let msg: string = format_error(err)
    assert_true(std.string.contains(msg, "Invalid UTF-8"), "should contain 'Invalid UTF-8'")
    assert_true(std.string.contains(msg, "10"), "should contain position")
    assert_true(std.string.contains(msg, "InvalidStartByte"), "should contain error kind")
    return
}


// =============================================================================
// Test Runner
// =============================================================================

effect fn run_test(name: string, test_fn: fn() -> void) -> void {
    std.io.print("  ")
    std.io.print(name)
    std.io.print(" ... ")
    test_fn()
    std.io.println("ok")
    return
}

effect fn run_builder_tests() -> void {
    std.io.println("Convenience Constructors:")
    run_test("test_json_null", test_json_null)
    run_test("test_json_bool_true", test_json_bool_true)
    run_test("test_json_bool_false", test_json_bool_false)
    run_test("test_json_number", test_json_number)
    run_test("test_json_int", test_json_int)
    run_test("test_json_string", test_json_string)
    run_test("test_json_array", test_json_array)
    run_test("test_json_array_empty", test_json_array_empty)
    run_test("test_json_object", test_json_object)
    run_test("test_json_object_empty", test_json_object_empty)
    std.io.println("")

    std.io.println("Builder Pattern:")
    run_test("test_builder_empty", test_builder_empty)
    run_test("test_builder_with_string", test_builder_with_string)
    run_test("test_builder_with_number", test_builder_with_number)
    run_test("test_builder_with_int", test_builder_with_int)
    run_test("test_builder_with_bool", test_builder_with_bool)
    run_test("test_builder_with_null", test_builder_with_null)
    run_test("test_builder_chained", test_builder_chained)
    run_test("test_builder_preserves_order", test_builder_preserves_order)
    run_test("test_builder_nested_object", test_builder_nested_object)
    std.io.println("")
    return
}

effect fn run_edge_case_tests() -> void {
    std.io.println("Error Context:")
    run_test("test_format_error_with_context_single_line", test_format_error_with_context_single_line)
    run_test("test_format_error_with_context_multiline", test_format_error_with_context_multiline)
    run_test("test_format_error_with_context_unterminated_string", test_format_error_with_context_unterminated_string)
    std.io.println("")

    std.io.println("Edge Cases - Empty/Whitespace Input:")
    run_test("test_edge_empty_input", test_edge_empty_input)
    run_test("test_edge_whitespace_only_spaces", test_edge_whitespace_only_spaces)
    run_test("test_edge_whitespace_only_tabs", test_edge_whitespace_only_tabs)
    run_test("test_edge_whitespace_only_newlines", test_edge_whitespace_only_newlines)
    run_test("test_edge_whitespace_only_mixed", test_edge_whitespace_only_mixed)
    std.io.println("")

    std.io.println("Edge Cases - Nesting Depth:")
    run_test("test_edge_nesting_at_max_depth", test_edge_nesting_at_max_depth)
    run_test("test_edge_nesting_exceeds_max_depth", test_edge_nesting_exceeds_max_depth)
    run_test("test_edge_nesting_objects_at_max_depth", test_edge_nesting_objects_at_max_depth)
    run_test("test_edge_nesting_mixed_at_max_depth", test_edge_nesting_mixed_at_max_depth)
    std.io.println("")

    std.io.println("Edge Cases - Strings:")
    run_test("test_edge_string_with_special_chars", test_edge_string_with_special_chars)
    run_test("test_edge_string_with_unicode_escapes", test_edge_string_with_unicode_escapes)
    std.io.println("")

    std.io.println("Edge Cases - Arrays:")
    run_test("test_edge_array_10_elements", test_edge_array_10_elements)
    run_test("test_edge_array_mixed_types", test_edge_array_mixed_types)
    std.io.println("")

    std.io.println("Edge Cases - Unicode Escapes:")
    run_test("test_edge_unicode_escape_basic", test_edge_unicode_escape_basic)
    run_test("test_edge_unicode_escape_non_ascii", test_edge_unicode_escape_non_ascii)
    run_test("test_edge_unicode_escape_cjk", test_edge_unicode_escape_cjk)
    std.io.println("")
    return
}

effect fn run_property_tests() -> void {
    std.io.println("Property Tests - Roundtrip:")
    run_test("test_roundtrip_null_with_equals", test_roundtrip_null_with_equals)
    run_test("test_roundtrip_bool_true", test_roundtrip_bool_true)
    run_test("test_roundtrip_bool_false", test_roundtrip_bool_false)
    run_test("test_roundtrip_integer", test_roundtrip_integer)
    run_test("test_roundtrip_negative_number", test_roundtrip_negative_number)
    run_test("test_roundtrip_string_simple", test_roundtrip_string_simple)
    run_test("test_roundtrip_string_with_escapes", test_roundtrip_string_with_escapes)
    run_test("test_roundtrip_string_with_newlines", test_roundtrip_string_with_newlines)
    run_test("test_roundtrip_empty_array", test_roundtrip_empty_array)
    run_test("test_roundtrip_array_with_elements", test_roundtrip_array_with_elements)
    run_test("test_roundtrip_empty_object", test_roundtrip_empty_object)
    run_test("test_roundtrip_object_with_fields", test_roundtrip_object_with_fields)
    run_test("test_roundtrip_nested_structure", test_roundtrip_nested_structure)
    std.io.println("")

    std.io.println("Property Tests - Determinism:")
    run_test("test_stringify_determinism_same_output", test_stringify_determinism_same_output)
    run_test("test_stringify_determinism_nested", test_stringify_determinism_nested)
    std.io.println("")

    std.io.println("Property Tests - Parse Consistency:")
    run_test("test_parse_consistency_valid_never_crashes", test_parse_consistency_valid_never_crashes)
    run_test("test_parse_consistency_invalid_never_crashes", test_parse_consistency_invalid_never_crashes)
    std.io.println("")
    return
}

