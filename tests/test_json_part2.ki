// --- Type Constraint Tests ---

let test_schema_type_null_valid: fn() -> void = fn() -> void {
    // Arrange
    let json: Json = JNull
    let schema: Schema = schema_type("null")

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_ok_schema(result, "null should match null type")
    return
}

let test_schema_type_null_invalid: fn() -> void = fn() -> void {
    // Arrange
    let json: Json = JString("not null")
    let schema: Schema = schema_type("null")

    // Act
    let result: Result[bool, List[SchemaError]] = validate(json, schema)

    // Assert
    assert_err_schema(result, "string should not match null type")
    match result {
        Err(errors) => {
            match errors {
                Cons(TypeMismatch { expected: exp, actual: act, path: _ }, _) => {
                    assert(std.string.equals(exp, "null"), "expected should be null")
                    assert(std.string.equals(act, "string"), "actual should be string")
                }
                _ => { assert(false, "should be TypeMismatch error") }
            }
        }
        Ok(_) => { }
    }
    return
}

